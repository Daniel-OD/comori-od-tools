# Copiază în .env și ajustează
DATABASE_URL=postgresql://comori:comori@localhost:5432/comori
BASE_URL=https://comori-od.ro
# Identifică-te onest; pune un contact real ca să te poată găsi administratorii site-ului
USER_AGENT=ComoriSearchBot/0.1 (proiect personal de studiu; contact: email@exemplu.ro)
REQUEST_INTERVAL=1.5
# Embeddings: intfloat/multilingual-e5-base (768) | intfloat/multilingual-e5-large (1024) | BAAI/bge-m3 (1024)
EMBED_MODEL=intfloat/multilingual-e5-base
# "st" = sentence-transformers (real) ; "fake" = doar pentru teste, NU este semantic
EMBEDDER=st
# Praguri pentru "Căutare după idee" (se calibrează pe lotul-pilot, vezi README)
IDEA_MIN_SIM=0.80
IDEA_REL_DROP=0.07
# Origini permise pentru apeluri din browser (separate prin virgulă)
ALLOWED_ORIGINS=https://daniel-od.github.io,http://localhost:8080
